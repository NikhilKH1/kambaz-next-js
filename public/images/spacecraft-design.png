<svg width="300" height="200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="spacecraftGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#c0c0c0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#808080;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="200" fill="#000033"/>
  <g transform="translate(150,100)">
    <!-- Main spacecraft body -->
    <rect x="-20" y="-30" width="40" height="60" rx="5" fill="url(#spacecraftGrad)"/>
    <!-- Solar panels -->
    <rect x="-50" y="-15" width="20" height="30" fill="#4169e1"/>
    <rect x="30" y="-15" width="20" height="30" fill="#4169e1"/>
    <!-- Antenna -->
    <line x1="0" y1="-30" x2="0" y2="-45" stroke="#c0c0c0" stroke-width="2"/>
    <circle cx="0" cy="-45" r="3" fill="#c0c0c0"/>
    <!-- Thrusters -->
    <circle cx="-15" cy="30" r="3" fill="#ff4500"/>
    <circle cx="15" cy="30" r="3" fill="#ff4500"/>
    <!-- Stars -->
    <circle cx="-100" cy="-60" r="1" fill="white"/>
    <circle cx="80" cy="-40" r="1.5" fill="white"/>
    <circle cx="-70" cy="50" r="1" fill="white"/>
    <circle cx="90" cy="70" r="1.5" fill="white"/>
    <circle cx="-40" cy="-80" r="1" fill="white"/>
  </g>
  <text x="150" y="180" text-anchor="middle" fill="white" font-family="Arial" font-size="16" font-weight="bold">SPACECRAFT DESIGN</text>
</svg>
