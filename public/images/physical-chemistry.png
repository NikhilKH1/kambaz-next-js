<svg width="300" height="200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="physicsGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#9c27b0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#673ab7;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="200" fill="#f3e5f5"/>
  <g transform="translate(150,100)">
    <!-- Atom model -->
    <circle cx="0" cy="0" r="15" fill="url(#physicsGrad)"/>
    <!-- Electron orbits -->
    <ellipse cx="0" cy="0" rx="40" ry="25" fill="none" stroke="#9c27b0" stroke-width="2" opacity="0.6"/>
    <ellipse cx="0" cy="0" rx="60" ry="35" fill="none" stroke="#9c27b0" stroke-width="2" opacity="0.4"/>
    <!-- Electrons -->
    <circle cx="40" cy="0" r="4" fill="#ff9800"/>
    <circle cx="-40" cy="0" r="4" fill="#ff9800"/>
    <circle cx="0" cy="25" r="4" fill="#ff9800"/>
    <circle cx="0" cy="-25" r="4" fill="#ff9800"/>
    <circle cx="30" cy="20" r="4" fill="#ff9800"/>
    <circle cx="-30" cy="-20" r="4" fill="#ff9800"/>
    <!-- Wave equations -->
    <path d="M-80,-40 Q-70,-50 -60,-40 T-40,-40" stroke="#673ab7" stroke-width="2" fill="none"/>
    <path d="M-80,-20 Q-70,-30 -60,-20 T-40,-20" stroke="#673ab7" stroke-width="2" fill="none"/>
    <path d="M-80,0 Q-70,-10 -60,0 T-40,0" stroke="#673ab7" stroke-width="2" fill="none"/>
    <!-- Formula -->
    <text x="80" y="-20" fill="#333" font-family="Arial" font-size="12">E = mc²</text>
    <text x="80" y="0" fill="#333" font-family="Arial" font-size="12">ΔG = ΔH - TΔS</text>
    <text x="80" y="20" fill="#333" font-family="Arial" font-size="12">PV = nRT</text>
  </g>
  <text x="150" y="180" text-anchor="middle" fill="#333" font-family="Arial" font-size="16" font-weight="bold">PHYSICAL CHEMISTRY</text>
</svg>
