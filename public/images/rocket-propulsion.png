<svg width="300" height="200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="rocketGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ff6b35;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f7931e;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="200" fill="#1a1a2e"/>
  <g transform="translate(150,100)">
    <!-- Rocket body -->
    <ellipse cx="0" cy="-20" rx="15" ry="40" fill="url(#rocketGrad)"/>
    <!-- Rocket nose -->
    <polygon points="0,-60 -10,-50 10,-50" fill="#ff6b35"/>
    <!-- Fins -->
    <polygon points="-15,-10 -25,10 -15,0" fill="#ff6b35"/>
    <polygon points="15,-10 25,10 15,0" fill="#ff6b35"/>
    <!-- Flame -->
    <ellipse cx="0" cy="25" rx="8" ry="15" fill="#ff4500"/>
    <ellipse cx="0" cy="35" rx="6" ry="12" fill="#ffa500"/>
    <!-- Stars -->
    <circle cx="-80" cy="-60" r="2" fill="white"/>
    <circle cx="70" cy="-40" r="1.5" fill="white"/>
    <circle cx="-60" cy="40" r="1" fill="white"/>
    <circle cx="80" cy="60" r="2" fill="white"/>
  </g>
  <text x="150" y="180" text-anchor="middle" fill="white" font-family="Arial" font-size="16" font-weight="bold">ROCKET PROPULSION</text>
</svg>
