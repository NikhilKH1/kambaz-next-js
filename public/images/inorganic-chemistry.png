<svg width="300" height="200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="inorgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ff6b6b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ee5a24;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="200" fill="#fff5f5"/>
  <g transform="translate(150,100)">
    <!-- Crystal structure -->
    <polygon points="0,-40 -20,-20 -20,20 0,40 20,20 20,-20" fill="url(#inorgGrad)"/>
    <polygon points="0,-20 -10,-10 -10,10 0,20 10,10 10,-10" fill="#ff8a80"/>
    <!-- Metal atoms -->
    <circle cx="-50" cy="-30" r="8" fill="#c0c0c0"/>
    <circle cx="50" cy="-30" r="8" fill="#c0c0c0"/>
    <circle cx="-50" cy="30" r="8" fill="#c0c0c0"/>
    <circle cx="50" cy="30" r="8" fill="#c0c0c0"/>
    <!-- Bonds -->
    <line x1="0" y1="-20" x2="-50" y2="-30" stroke="#333" stroke-width="2"/>
    <line x1="0" y1="-20" x2="50" y2="-30" stroke="#333" stroke-width="2"/>
    <line x1="0" y1="20" x2="-50" y2="30" stroke="#333" stroke-width="2"/>
    <line x1="0" y1="20" x2="50" y2="30" stroke="#333" stroke-width="2"/>
    <!-- Periodic table elements -->
    <rect x="-80" y="-60" width="25" height="20" fill="#e3f2fd" stroke="#333"/>
    <text x="-67" y="-47" text-anchor="middle" fill="#333" font-family="Arial" font-size="10">Fe</text>
    <rect x="-50" y="-60" width="25" height="20" fill="#e3f2fd" stroke="#333"/>
    <text x="-37" y="-47" text-anchor="middle" fill="#333" font-family="Arial" font-size="10">Cu</text>
    <rect x="-20" y="-60" width="25" height="20" fill="#e3f2fd" stroke="#333"/>
    <text x="-7" y="-47" text-anchor="middle" fill="#333" font-family="Arial" font-size="10">Zn</text>
  </g>
  <text x="150" y="180" text-anchor="middle" fill="#333" font-family="Arial" font-size="16" font-weight="bold">INORGANIC CHEMISTRY</text>
</svg>
