<svg width="300" height="200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="chemGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#32cd32;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#228b22;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="200" fill="#f0f8ff"/>
  <g transform="translate(150,100)">
    <!-- Molecule structure -->
    <circle cx="0" cy="0" r="8" fill="url(#chemGrad)"/>
    <circle cx="-30" cy="-20" r="6" fill="#ff6b6b"/>
    <circle cx="30" cy="-20" r="6" fill="#4ecdc4"/>
    <circle cx="-20" cy="25" r="6" fill="#45b7d1"/>
    <circle cx="20" cy="25" r="6" fill="#f9ca24"/>
    <!-- Bonds -->
    <line x1="0" y1="0" x2="-30" y2="-20" stroke="#333" stroke-width="3"/>
    <line x1="0" y1="0" x2="30" y2="-20" stroke="#333" stroke-width="3"/>
    <line x1="0" y1="0" x2="-20" y2="25" stroke="#333" stroke-width="3"/>
    <line x1="0" y1="0" x2="20" y2="25" stroke="#333" stroke-width="3"/>
    <!-- Test tubes -->
    <rect x="-80" y="-30" width="15" height="40" rx="2" fill="#e0e0e0"/>
    <rect x="-60" y="-30" width="15" height="40" rx="2" fill="#e0e0e0"/>
    <rect x="-40" y="-30" width="15" height="40" rx="2" fill="#e0e0e0"/>
    <!-- Liquid in tubes -->
    <rect x="-78" y="-10" width="11" height="20" fill="#32cd32"/>
    <rect x="-58" y="-20" width="11" height="30" fill="#ff6b6b"/>
    <rect x="-38" y="-15" width="11" height="25" fill="#4ecdc4"/>
  </g>
  <text x="150" y="180" text-anchor="middle" fill="#333" font-family="Arial" font-size="16" font-weight="bold">ORGANIC CHEMISTRY</text>
</svg>
